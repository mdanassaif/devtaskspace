# Authentication
AUTH_SECRET=replace-with-long-random-string
AUTH_USERNAME=admin
# Wrap in quotes if value contains #, spaces, or special chars.
AUTH_PASSWORD=change-this-password

# Email (Resend)
RESEND_API_KEY=re_...
ALERT_EMAIL=you@example.com
FROM_EMAIL=Stacker <alerts@yourdomain.com>

# Optional: you can also set Resend values from in-app Settings.

# Supabase (core cross-device sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

